# Get these at https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Chats to watch, comma separated. Use @usernames or numeric IDs
# (run `python forwarder.py --list-chats` to find IDs of private channels).
SOURCE_CHATS=@some_channel,-1001234567890

# Where to send the messages: @username, numeric ID, or "me" (Saved Messages).
DESTINATION_CHATS=@my_friend

# forward = keeps the "Forwarded from ..." header
# copy    = sends the message as if you wrote it (no header)
FORWARD_MODE=forward

# File name for the login session (a .session file is created next to it).
SESSION_NAME=forwarder

LOG_LEVEL=INFO
